# Zhihu Bridge 配置示例（只有键名与安全默认值，不含任何真实密钥）。
# 本项目不会自动读取 .env 文件：请在启动前把需要的值设置为环境变量
# （PowerShell：$env:LLM_PROVIDER="disabled"；cmd：set LLM_PROVIDER=disabled；Linux/macOS：export LLM_PROVIDER=disabled）。
# 不要把真实密钥写进仓库文件。

# ---- 模型（默认 disabled：证据查看；fake 仅用于开发验收） ----
LLM_PROVIDER=disabled
# 硅基流动国内站：设置 LLM_PROVIDER=siliconflow，默认 DeepSeek V4.1 Flash，可用 SILICONFLOW_MODEL 覆盖。
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
# 其他实时生成可用 openai_compatible 或 zhihu_direct。知乎直答使用下方 Access Secret。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAIN_MODEL=
LLM_LIGHT_MODEL=
LLM_DAILY_CAP=1000
LLM_TIMEOUT_S=

# ---- 知乎开放平台（默认关闭实时调用） ----
ZHIHU_LIVE_ENABLED=false
# 已有精选证据的预置案例默认不消耗共享实时搜索额度；设为 true 时强制额外检索。
ZHIHU_PRESET_LIVE_SEARCH=false
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE=https://developer.zhihu.com
ZHIHU_SEARCH_PATH=/api/v1/content/zhihu_search
ZHIHU_QUESTION_REC_PATH=/api/v1/user/question_recommendations
ZHIHU_SOFT_TIMEOUT_S=5
SSE_KEEPALIVE_S=10

# ---- 预算与限流（V6 §6.8 初值） ----
BUDGET_ZHIHU_SEARCH_PUBLIC_CAP=6
BUDGET_QUESTION_DISCOVERY_PUBLIC_CAP=6
RATE_LIMIT_RUNS_PER_IP_HOUR=120
RATE_LIMIT_TESTS_PER_IP_HOUR=120
RATE_LIMIT_DRAFTS_PER_IP_HOUR=120
GLOBAL_MAX_CONCURRENT_RUNS=3
TRUSTED_PROXY_IPS=

# ---- 本地文件位置（留空使用默认值：app/var/bridge.sqlite3、app/fixtures、app/web/dist） ----
DB_PATH=
FIXTURES_DIR=
WEB_DIST=

# ---- 本地演示：fake 适配器节奏与故障演练（只影响 fake） ----
# FAKE_FAILURE 可选：none | generate（生成失败→降级）| rewrite | retell_partial（复述 4/6）| zhihu（回流查询失败）
FAKE_STEP_DELAY_MS=350
FAKE_FAILURE=none
TEST_TIMEOUT_S=
